NODE_ENV=development
PORT=5001

# Comma-separated allowed browser origins.
FRONTEND_URLS=http://localhost:5173,http://localhost:4173

# MongoDB
MONGO_URI=mongodb://localhost:27017/mythicmart
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# Auth
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_32_chars
JWT_EXPIRE=7d

# API hardening
BODY_LIMIT=20kb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Shopify Headless
SHOPIFY_STORE_DOMAIN=your-store-domain.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token
# Admin token needs read_products and read_inventory for database synchronization.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SYNC_ON_START=false
SHOPIFY_SYNC_INTERVAL_MS=0

# Payments (Stripe / Gateway)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email & Notification Provider (Nodemailer / SMTP / Resend)
EMAIL_FROM="MythicMart <support@mythicmart.com>"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
RESEND_API_KEY=re_your_resend_api_key
